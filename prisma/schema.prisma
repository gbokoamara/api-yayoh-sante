generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CUSTOMER
  ADMIN
}

// ================= USER ================= 
model User {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  email         String    @unique
  password      String
  firstName     String
  lastName      String
  nationality   String?
  phone         String
  imageUrl      String?
  role          UserRole  @default(CUSTOMER)
  isActive      Boolean   @default(true)
  isDelete      Boolean   @default(false)
  addresses     String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  testimonials  Testimonial[]
}

// ================= PRODUCT =================
model Product {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  title           String
  subtitle        String?
  price           Float?
  description     String
  traditionalUse  String
  disclaimer      String   @default("Ce produit est un témoignage d'un savoir-faire traditionnel...")
  mainImage       String
  images          String[]
  contactPhone    String?
  whatsappNumber  String?
  email           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  testimonials    Testimonial[]
  galleries       Gallery[]
}

// ================= TESTIMONIAL =================
model Testimonial {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  location  String
  text      String
  rating    Int      @default(5)
  avatar    String?
  videoUrl  String?
  approved  Boolean  @default(false) // mieux false
  isDelete  Boolean  @default(false) // mieux false
  createdAt DateTime @default(now())
  productId String   @db.ObjectId
  userId    String   @db.ObjectId 

  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ================= GALLERY =================
model Gallery {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  title     String
  imageUrl  String
  videoUrl  String?
  type      String   @default("image")
  order     Int      @default(0)
  productId String?  @db.ObjectId

  product   Product? @relation(fields: [productId], references: [id], onDelete: Cascade)
}

// ================= SITE SETTINGS =================
model SiteSettings {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  contactPhone   String
  whatsappNumber String
  email          String
  address        String?
  socialLinks    Json?
  updatedAt      DateTime @updatedAt
}